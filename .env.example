# Cursor API key — get one at https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Optional: override default model for local Cursor agents
CURSOR_MODEL=composer-2.5

# OpenRouter (lite harness) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override default OpenRouter model
OPENROUTER_MODEL=anthropic/claude-sonnet-4
